{
  "entities": {
    "FavoriteWallpaper": {
      "title": "FavoriteWallpaper",
      "description": "A user's favorited wallpaper reference synced across devices.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated owner UID" },
        "wallpaperId": { "type": "string", "description": "Catalog wallpaper identifier" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["userId", "wallpaperId", "createdAt"]
    },
    "WallpaperCollection": {
      "title": "WallpaperCollection",
      "description": "A user-created personal wallpaper collection.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated owner UID" },
        "name": { "type": "string", "description": "Collection display title" },
        "description": { "type": "string", "description": "Optional collection description" },
        "wallpaperIds": { "type": "array", "description": "Bounded list of wallpaper IDs in this collection" },
        "coverUrl": { "type": "string", "description": "Optional cover thumbnail URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["userId", "name", "wallpaperIds", "createdAt", "updatedAt"]
    },
    "RecentlyViewedItem": {
      "title": "RecentlyViewedItem",
      "description": "A recently inspected wallpaper entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated owner UID" },
        "wallpaperId": { "type": "string", "description": "Catalog wallpaper identifier" },
        "viewedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of latest view" }
      },
      "required": ["userId", "wallpaperId", "viewedAt"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Synced theme, image quality, download, and search history preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated owner UID" },
        "themeMode": { "type": "string", "enum": ["SYSTEM", "LIGHT", "DARK"], "description": "Selected theme mode" },
        "amoledDark": { "type": "boolean", "description": "Whether dark mode uses pure AMOLED pitch black surfaces" },
        "imageQuality": { "type": "string", "enum": ["ORIGINAL", "HIGH", "BALANCED"], "description": "Preferred browsing/download quality" },
        "wifiOnlyDownloads": { "type": "boolean", "description": "Prefer Wi-Fi for high-res downloads" },
        "recentSearches": { "type": "array", "description": "Recent search query strings (max 15)" },
        "homeCategoryChipsEnabled": { "type": "boolean", "description": "Optional toggle to display category filter chips on Home (default false)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server update timestamp" }
      },
      "required": ["userId", "themeMode", "amoledDark", "imageQuality", "wifiOnlyDownloads", "recentSearches", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/favorites/{wallpaperId}": {
      "schema": { "$ref": "#/entities/FavoriteWallpaper" },
      "description": "User-scoped favorite wallpapers"
    },
    "/users/{userId}/collections/{collectionId}": {
      "schema": { "$ref": "#/entities/WallpaperCollection" },
      "description": "User-scoped personal wallpaper collections"
    },
    "/users/{userId}/recentlyViewed/{wallpaperId}": {
      "schema": { "$ref": "#/entities/RecentlyViewedItem" },
      "description": "User-scoped recently viewed wallpapers"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserPreferences" },
      "description": "User-scoped appearance, quality, and search history settings"
    }
  }
}
