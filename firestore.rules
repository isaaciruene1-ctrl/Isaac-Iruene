rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidFavorite(data, userId, wallpaperId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.wallpaperId is string &&
             data.wallpaperId == wallpaperId &&
             isValidId(data.wallpaperId) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    function isValidCollection(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 60 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 240)) &&
             data.wallpaperIds is list &&
             data.wallpaperIds.size() <= 150 &&
             (data.wallpaperIds.size() == 0 || data.wallpaperIds[0] is string) &&
             (!('coverUrl' in data) || data.coverUrl == null || (data.coverUrl is string && data.coverUrl.size() <= 500)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidRecentlyViewed(data, userId, wallpaperId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.wallpaperId is string &&
             data.wallpaperId == wallpaperId &&
             isValidId(data.wallpaperId) &&
             data.viewedAt is timestamp &&
             data.viewedAt <= request.time;
    }

    function isValidUserPreferences(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.themeMode in ['SYSTEM', 'LIGHT', 'DARK'] &&
             data.amoledDark is bool &&
             data.imageQuality in ['ORIGINAL', 'HIGH', 'BALANCED'] &&
             data.wifiOnlyDownloads is bool &&
             data.recentSearches is list &&
             data.recentSearches.size() <= 15 &&
             (data.recentSearches.size() == 0 || data.recentSearches[0] is string) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow read, write: if false;

      match /favorites/{wallpaperId} {
        allow get: if isOwner(userId) && isValidId(wallpaperId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(wallpaperId) &&
                         incoming().keys().hasAll(['userId', 'wallpaperId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'wallpaperId', 'createdAt']) &&
                         isValidFavorite(incoming(), userId, wallpaperId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(wallpaperId);
      }

      match /collections/{collectionId} {
        allow get: if isOwner(userId) && isValidId(collectionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(collectionId) &&
                         incoming().keys().hasAll(['userId', 'name', 'wallpaperIds', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'description', 'wallpaperIds', 'coverUrl', 'createdAt', 'updatedAt']) &&
                         isValidCollection(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(collectionId) &&
                         isValidCollection(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'wallpaperIds', 'coverUrl', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(collectionId);
      }

      match /recentlyViewed/{wallpaperId} {
        allow get: if isOwner(userId) && isValidId(wallpaperId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(wallpaperId) &&
                         incoming().keys().hasAll(['userId', 'wallpaperId', 'viewedAt']) &&
                         incoming().keys().hasOnly(['userId', 'wallpaperId', 'viewedAt']) &&
                         isValidRecentlyViewed(incoming(), userId, wallpaperId);
        allow update: if isOwner(userId) &&
                         isValidId(wallpaperId) &&
                         isValidRecentlyViewed(incoming(), userId, wallpaperId) &&
                         incoming().userId == existing().userId &&
                         incoming().wallpaperId == existing().wallpaperId &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['viewedAt']);
        allow delete: if isOwner(userId) && isValidId(wallpaperId);
      }

      match /preferences/{prefId} {
        allow get: if isOwner(userId) && prefId == 'settings';
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         prefId == 'settings' &&
                         incoming().keys().hasAll(['userId', 'themeMode', 'amoledDark', 'imageQuality', 'wifiOnlyDownloads', 'recentSearches', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'themeMode', 'amoledDark', 'imageQuality', 'wifiOnlyDownloads', 'recentSearches', 'createdAt', 'updatedAt']) &&
                         isValidUserPreferences(incoming(), userId);
        allow update: if isOwner(userId) &&
                         prefId == 'settings' &&
                         isValidUserPreferences(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['themeMode', 'amoledDark', 'imageQuality', 'wifiOnlyDownloads', 'recentSearches', 'updatedAt']);
        allow delete: if isOwner(userId) && prefId == 'settings';
      }
    }
  }
}
